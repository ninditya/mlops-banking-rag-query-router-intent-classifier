# Copy file ini ke .env lalu isi nilainya
# cp .env.example .env

# ── Model ──────────────────────────────────────────
MODEL_DIR=workflow_ci/artifacts

# ── RAG Backend ────────────────────────────────────
# Pilih: faiss | qdrant  (default: faiss, in-process, tanpa server)
RAG_BACKEND=faiss

# Qdrant (aktif jika RAG_BACKEND=qdrant). Kosongkan QDRANT_URL untuk
# jalan in-memory (tanpa server, cukup untuk dev/demo).
QDRANT_URL=
QDRANT_API_KEY=

# ── LLM Provider ───────────────────────────────────
# Pilih: openai | ollama | mock  (default: mock)
LLM_PROVIDER=mock

# OpenAI (aktif jika LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama lokal (aktif jika LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── MLflow / DagsHub ───────────────────────────────
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
